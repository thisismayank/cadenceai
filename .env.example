# --- Database ---
# Neon Postgres connection string (pooled).
DATABASE_URL="postgres://user:pass@ep-xxx.neon.tech/neondb?sslmode=require"

# --- Inngest ---
# In dev, use the Inngest dev server: `npx inngest-cli@latest dev`.
# Leave these blank locally and Inngest SDK talks to the dev server via INNGEST_DEV=1.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# --- Anthropic (Phase 1) ---
# Not required in Phase 0. Skip until agents come online.
ANTHROPIC_API_KEY=""

# --- GitHub (Phase 1) ---
# Not required in Phase 0.
GITHUB_TOKEN=""

# --- E2B (Phase 1) ---
# Not required in Phase 0.
E2B_API_KEY=""

# --- Control plane ---
# AES-256-GCM master key for encrypting secrets at rest.
# Generate: openssl rand -hex 32
CADENCEAI_MASTER_KEY=""

# Optional cookie for single-user auth if you expose beyond localhost.
CADENCEAI_SESSION=""
