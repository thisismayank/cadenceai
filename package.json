{
  "name": "cadenceai",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "pnpm --filter @cadenceai/web dev",
    "cli": "pnpm --filter @cadenceai/cli dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @cadenceai/db generate",
    "db:migrate": "pnpm --filter @cadenceai/db migrate",
    "db:studio": "pnpm --filter @cadenceai/db studio"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
